# 로그인·API 인증 비밀번호
APP_PASSWORD=
# 세션 쿠키 서명용 무작위 값 (openssl rand -hex 32)
SESSION_SECRET=
# 서버 외부 주소 (빌드 실행 시 필수)
ORIGIN=http://macbook.local:3000
# SQLite 파일 경로
DATABASE_PATH=data/vocab.db
PORT=3000
# 사진 등록용 OpenAI API 키
# 없으면 사진 등록만 막힌다
OPENAI_API_KEY=
# 요청 본문 한도 (npm start와 배포에 해당, npm run dev에는 한도가 없다)
# 기본 512K라 사진이 막힌다
BODY_SIZE_LIMIT=20M

# --- devserver 배포에만 둔다 (docker-compose.yml) ---
# 접속 IP를 읽을 헤더
# Mac에 두면 이 헤더가 없는 요청의 로그인이 500이 된다
# ADDRESS_HEADER=cf-connecting-ip
